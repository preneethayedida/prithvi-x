# PRITHVI-X Environment Configuration Template
# Copy this file to .env before starting the services

# General
NODE_ENV=development

# Backend Service
PORT=5000
MONGO_URI=mongodb://localhost:27017/prithvix
CORS_ORIGIN=http://localhost:5173

# Python Analytics Service
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_PORT=8000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Ingestion Settings
INGESTION_INTERVAL_CRON="0 */3 * * *"
ENABLE_AUTO_INGESTION=true
USE_FALLBACK_IF_API_FAILS=true

# External APIs (Optional - Open-Meteo works without keys, but custom keys can be specified here)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_AQI_URL=https://air-quality-api.open-meteo.com/v1/air-quality
